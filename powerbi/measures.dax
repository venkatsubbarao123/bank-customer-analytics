Total Transactions = COUNTROWS(BankTransactions)
Total Transaction Value = SUM(BankTransactions[transaction_amount_inr])
Average Transaction = AVERAGE(BankTransactions[transaction_amount_inr])
Median Transaction = MEDIAN(BankTransactions[transaction_amount_inr])
Maximum Transaction = MAX(BankTransactions[transaction_amount_inr])
Minimum Transaction = MIN(BankTransactions[transaction_amount_inr])
Unique Customers = DISTINCTCOUNT(BankTransactions[customer_id])
Average Account Balance = AVERAGE(BankTransactions[customer_account_balance])
Transaction Value per Customer = DIVIDE([Total Transaction Value], [Unique Customers])
Customer Contribution % = DIVIDE([Total Transaction Value], CALCULATE([Total Transaction Value], ALL(BankTransactions[customer_id])))
Running Transaction Value = CALCULATE([Total Transaction Value], FILTER(ALLSELECTED('Date'[Date]), 'Date'[Date] <= MAX('Date'[Date])))
Previous Month Value = CALCULATE([Total Transaction Value], DATEADD('Date'[Date], -1, MONTH))
Transaction MoM % = DIVIDE([Total Transaction Value] - [Previous Month Value], [Previous Month Value])
Average Transaction by Location = AVERAGE(BankTransactions[transaction_amount_inr])
High Value Transactions = CALCULATE([Total Transactions], BankTransactions[transaction_value_group] = "High Value")
